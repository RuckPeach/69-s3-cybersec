
@host = {{$dotenv TEST_HOST}}

# Admin Credentials
@admin_email = {{$dotenv TEST_ADMIN_EMAIL}}
@admin_password = {{$dotenv TEST_ADMIN_PASSWORD}}

# User Credentials
@user_identifier = {{$dotenv TEST_USER_IDENTIFIER}}
@user_email = {{$dotenv TEST_USER_EMAIL}}
@user_username = {{$dotenv TEST_USER_USERNAME}}
@user_password = {{$dotenv TEST_USER_PASSWORD}}

#Tokens ที่ได้จาก login response
@admin_token = {{$dotenv TEST_ADMIN_TOKEN}}
@user_token = {{$dotenv TEST_USER_TOKEN}}

#Admin Password Reset
@admin_reset_code = {{$dotenv TEST_ADMIN_RESET_CODE}}
@admin_new_password = {{$dotenv TEST_ADMIN_NEW_PASSWORD}}

#User Password Reset
@user_reset_code = {{$dotenv TEST_USER_RESET_CODE}}
@user_new_password = {{$dotenv TEST_USER_NEW_PASSWORD}}




###########################################################################
# ADMIN SECTION
###########################################################################

### Admin Login
POST {{host}}/admin/login
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}",
  "rememberMe": true
}

### Admin Signup
# 400 Bad Request Only 1 Super Admin
POST {{host}}/admin/register-admin
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "firstname": "",
  "lastname": "",
  "password": "{{admin_password}}"
}

### Admin Forgot Password
POST {{host}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{admin_email}}"
}

### Admin Reset Password
POST {{host}}/admin/reset-password
Content-Type: application/json

{
  "password": "{{admin_new_password}}",
  "passwordConfirmation": "{{admin_new_password}}",
  "code": "{{admin_reset_code}}"
}

### Admin Profile
GET {{host}}/admin/users/me
Content-Type: application/json
Authorization: Bearer {{admin_token}}




###########################################################################
# USER SECTION
###########################################################################

### User Login
POST {{host}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{user_identifier}}",
  "password": "{{user_password}}",
  "rememberMe": true
}

### User Signup
POST {{host}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{user_username}}",
  "email": "{{user_email}}",
  "password": "{{user_password}}"
}

### User Forgot Password
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{user_email}}"
}

### User Reset Password
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
  "password": "{{user_new_password}}",
  "passwordConfirmation": "{{user_new_password}}",
  "code": "{{user_reset_code}}"
}

### User Profile
GET {{host}}/api/users/me
Content-Type: application/json
Authorization: Bearer {{user_token}}
